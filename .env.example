# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/lakshya2026

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Email Service (Nodemailer SMTP Configuration)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="LBRCE Lakshya 2026" <your_email@gmail.com>

# Payment Gateway (Razorpay)
# Sign up at https://dashboard.razorpay.com and generate test API keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
