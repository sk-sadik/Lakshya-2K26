# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/lakshya2027

# JWT Authentication (minimum 32 characters; production refuses to start without it)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Email Service (Nodemailer SMTP Configuration)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="LBRCE Lakshya 2027" <your_email@gmail.com>

# Payment Gateway (Razorpay) — required in production (server refuses to
# start or verify payments without these; no test-mode bypass exists)
# Sign up at https://dashboard.razorpay.com and generate API keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_optional

# Transactional email over HTTPS (preferred on hosts that block SMTP ports)
BREVO_API_KEY=your_brevo_api_key_optional
